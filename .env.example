# Copy to .env.local for local development. Never commit real values.

# Canonical public origin, without a trailing slash. Used for canonical URLs,
# Open Graph URLs, robots.txt and sitemap.xml. Falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Search engine indexing. Anything other than "true" emits a disallow-all
# robots.txt and noindex metadata, so preview/staging deployments stay private.
SITE_ALLOW_INDEXING=false

# Internal /design-system preview. Always available in development; production
# builds return 404 unless this is "true". The page is noindex either way.
ENABLE_DESIGN_SYSTEM_PREVIEW=false

# Static hosting (set by the GitHub Pages workflow). STATIC_EXPORT=true writes
# plain files to out/; NEXT_PUBLIC_BASE_PATH is the sub-path, e.g. /kingori.
STATIC_EXPORT=false
NEXT_PUBLIC_BASE_PATH=
